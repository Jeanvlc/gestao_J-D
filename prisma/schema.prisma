generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  obrigacoes Obrigacao[]
  processos  Processo[]
  tarefas    Tarefa[]
  clientes   Cliente[]
  modelosObrigacao ModeloObrigacao[]
}

// simples_nacional, lucro_presumido, lucro_real, mei, pessoa_fisica, produtor_rural
model Cliente {
  id               String   @id @default(cuid())
  nome             String
  cnpjCpf          String?
  regimeTributario String
  cidade           String?
  estado           String?
  ativo            Boolean  @default(true)

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  obrigacoes       Obrigacao[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([regimeTributario])
}

// Modelo de obrigação recorrente: gera 1 Obrigacao por Cliente/competência
// quando o cliente do regime/cidade do modelo bate com o cliente.
model ModeloObrigacao {
  id               String   @id @default(cuid())
  titulo           String
  descricao        String?
  tags             String[]
  diaVencimento    Int      // dia do mês em que a obrigação vence
  periodicidade    String   @default("mensal") // mensal, trimestral, anual
  prioridade       String   @default("normal")
  regimeTributario String?  // null = vale para qualquer regime
  cidade           String?  // null = vale para qualquer cidade
  ativo            Boolean  @default(true)

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  obrigacoesGeradas Obrigacao[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([regimeTributario])
}

model Obrigacao {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  vencimento    DateTime
  periodicidade String?  // "mensal", "trimestral", "anual", "unica"
  status        String   @default("pendente") // pendente, em_andamento, concluida, atrasada
  prioridade    String   @default("normal") // baixa, normal, alta
  cliente       String?
  tags          String[] // ISS, IR, SPED, ICMS, EFD, etc
  linkDocumento String?
  dataAtendimento DateTime?

  clienteId     String?
  clienteRef    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  modeloId      String?
  modelo        ModeloObrigacao? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  competencia   String?  // "YYYY-MM" do mês em que essa obrigação foi gerada, evita duplicar geração

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([vencimento])
  @@index([status])
  @@index([clienteId])
  @@unique([modeloId, clienteId, competencia])
}

model Processo {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  descricaoDetalhada String?
  etapas        Etapa[]
  status        String   @default("ativo") // ativo, inativo, concluido
  responsavel   String?
  frequencia    String?  // "mensal", "trimestral", "anual", "unica", "ocasional"
  tempoMedio    String?  // "1h", "2h", "1d", etc
  documentacao  String?  // URL ou arquivo
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}

model Etapa {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  ordem         Int
  concluida     Boolean  @default(false)
  dataConclisao DateTime?
  notas         String?
  
  processoId    String
  processo      Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([processoId])
}

model Tarefa {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  dataVencimento DateTime?
  status        String   @default("pendente") // pendente, em_progresso, concluida
  prioridade    String   @default("normal")
  categoria     String?  // "Urgente", "Importante", "Rotina", etc
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}
