generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  senha     String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  obrigacoes Obrigacao[]
  processos  Processo[]
  tarefas    Tarefa[]
  clientes   Cliente[]
  modelosObrigacao ModeloObrigacao[]
  honorarios Honorario[]
  pagamentosHonorario PagamentoHonorario[]
}

// simples_nacional, lucro_presumido, lucro_real, mei, pessoa_fisica, produtor_rural
model Cliente {
  id               String   @id @default(cuid())
  nome             String
  razaoSocial      String?
  nomeFantasia     String?
  cnpjCpf          String?
  tipoPessoa       String   @default("juridica") // juridica, fisica
  regimeTributario String
  inscricaoEstadual  String?
  inscricaoMunicipal String?
  email            String?
  telefone         String?
  responsavel      String?
  cep              String?
  logradouro       String?
  numero           String?
  complemento      String?
  bairro           String?
  cidade           String?
  estado           String?
  situacaoCadastral  String?
  atividadePrincipal String?
  dataAbertura     DateTime?
  // Usados pelo motor de obrigações para decidir quais modelos se aplicam ao cliente
  possuiFuncionarios Boolean @default(false)
  possuiIcms         Boolean @default(false)
  possuiRetencoes    Boolean @default(false)
  observacoes      String?
  ativo            Boolean  @default(true)

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  obrigacoes       Obrigacao[]
  honorarios       Honorario[]
  pagamentosHonorario PagamentoHonorario[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([regimeTributario])
}

// Modelo de obrigação recorrente: gera 1 Obrigacao por Cliente/competência
// quando o cliente do regime/cidade do modelo bate com o cliente.
model ModeloObrigacao {
  id               String   @id @default(cuid())
  titulo           String
  descricao        String?
  tags             String[]
  diaVencimento    Int      // dia do mês em que a obrigação vence
  periodicidade    String   @default("mensal") // mensal, trimestral, anual
  prioridade       String   @default("normal")
  regimeTributario String?  // null = vale para qualquer regime
  estado           String?  // null = vale para qualquer estado
  cidade           String?  // null = vale para qualquer cidade
  // Critérios do motor de obrigações: null = indiferente, true/false = exige que o cliente tenha/não tenha
  requerFuncionarios Boolean?
  requerIcms         Boolean?
  requerRetencoes    Boolean?
  ativo            Boolean  @default(true)

  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  obrigacoesGeradas Obrigacao[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([regimeTributario])
}

model Obrigacao {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  vencimento    DateTime
  periodicidade String?  // "mensal", "trimestral", "anual", "unica"
  status        String   @default("pendente") // pendente, em_andamento, concluida, atrasada
  prioridade    String   @default("normal") // baixa, normal, alta
  cliente       String?
  tags          String[] // ISS, IR, SPED, ICMS, EFD, etc
  linkDocumento String?
  dataAtendimento DateTime?

  clienteId     String?
  clienteRef    Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)

  modeloId      String?
  modelo        ModeloObrigacao? @relation(fields: [modeloId], references: [id], onDelete: SetNull)
  competencia   String?  // "YYYY-MM" do mês em que essa obrigação foi gerada, evita duplicar geração

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([vencimento])
  @@index([status])
  @@index([clienteId])
  @@unique([modeloId, clienteId, competencia])
}

model Processo {
  id            String   @id @default(cuid())
  nome          String
  descricao     String?
  descricaoDetalhada String?
  etapas        Etapa[]
  status        String   @default("ativo") // ativo, inativo, concluido
  responsavel   String?
  frequencia    String?  // "mensal", "trimestral", "anual", "unica", "ocasional"
  tempoMedio    String?  // "1h", "2h", "1d", etc
  documentacao  String?  // URL ou arquivo
  
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
}

model Etapa {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  ordem         Int
  concluida     Boolean  @default(false)
  dataConclisao DateTime?
  notas         String?
  
  processoId    String
  processo      Processo @relation(fields: [processoId], references: [id], onDelete: Cascade)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@index([processoId])
}

model Tarefa {
  id            String   @id @default(cuid())
  titulo        String
  descricao     String?
  dataVencimento DateTime?
  status        String   @default("pendente") // pendente, em_progresso, concluida
  prioridade    String   @default("normal")
  categoria     String?  // "Urgente", "Importante", "Rotina", etc

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Contrato de honorário mensal de um cliente (valor recorrente + dia de vencimento)
model Honorario {
  id            String   @id @default(cuid())
  descricao     String?
  valor         Float
  diaVencimento Int
  ativo         Boolean  @default(true)

  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  pagamentos    PagamentoHonorario[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([clienteId])
}

// Uma cobrança mensal gerada a partir de um Honorario, para controle financeiro (vencimento/pagamento)
model PagamentoHonorario {
  id            String   @id @default(cuid())
  competencia   String   // "YYYY-MM"
  valor         Float
  vencimento    DateTime
  status        String   @default("pendente") // pendente, pago, atrasado
  dataPagamento DateTime?
  observacoes   String?

  honorarioId   String
  honorario     Honorario @relation(fields: [honorarioId], references: [id], onDelete: Cascade)

  clienteId     String
  cliente       Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([vencimento])
  @@index([status])
  @@index([clienteId])
  @@unique([honorarioId, competencia])
}
